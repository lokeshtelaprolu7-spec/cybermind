# Frontend Environment Variables Template
# In local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# In production (set in Vercel / Netlify / Render / Cloudflare Pages):
# NEXT_PUBLIC_API_URL=https://api.cybermind.example.com/api
# Or if unified domain with reverse proxy:
# NEXT_PUBLIC_API_URL=/api
