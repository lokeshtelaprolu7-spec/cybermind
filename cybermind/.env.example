# CyberMIND Global Environment Configuration
APP_NAME=CyberMIND
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true

# Database (PostgreSQL with pgvector for prod; SQLite for zero-setup demo)
DATABASE_URL=sqlite:///./cybermind.db
# DATABASE_URL=postgresql://cybermind:cybermind_secure_pass@localhost:5432/cybermind

# Security
SECRET_KEY=cybermind-super-secure-jwt-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
LLM_API_KEY=sk-placeholder-for-openai-or-compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cybermind123

# Cache & Jobs
REDIS_URL=redis://localhost:6379/0

# Blockchain Evidence Provenance Layer
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=
